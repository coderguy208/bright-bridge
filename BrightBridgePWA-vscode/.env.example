# Supabase project URL used by the server-side journal function.
SUPABASE_URL=https://your-project.supabase.co

# Modern public key used for the prototype. Supabase RLS must protect the tables.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key

# Local testing only: set this in an uncommitted .env.local file to bypass Netlify Identity during `npm run dev`.
VITE_MOCK_AUTH=true
